# Optional. Copy to .env.local (gitignored). Never create a plain .env — it would be committed.

# Leave blank for live mode: the shared 4Geeks tracker API (the default).
# Set to "demo" for mock data served in the browser (nothing leaves the browser).
# Or set another API base URL. Restart dev / redeploy after changing.
NEXT_PUBLIC_PIPELINE_API_URL=
# NEXT_PUBLIC_PIPELINE_API_URL=demo
