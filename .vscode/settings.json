{
  "workbench.externalBrowser": "/Applications/Firefox.app/Contents/MacOS/firefox",
  "workbench.browser.openLocalhostLinks": false,
  "autoOpenLocalhostUrls": false,
  "glassOpenWebLinksInBrowser": false,
  "remote.forwardOnOpen": false,
  "remote.autoForwardPorts": true,
  "remote.autoForwardPortsSource": "hybrid",
  "remote.localPortHost": "localhost",
  "remote.otherPortsAttributes": {
    "onAutoForward": "notify"
  },
  "terminal.integrated.defaultProfile.osx": "bash",
  "terminal.integrated.profiles.osx": {
    "bash": {
      "path": "/bin/bash",
      "args": [
        "--rcfile",
        "${workspaceFolder}/.vscode/bashrc"
      ],
      "icon": "terminal-bash"
    },
    "zsh": {
      "path": "/bin/zsh"
    }
  },
  "remote.portsAttributes": {
    "3456": {
      "label": "Nexova Next.js",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "3000": {
      "onAutoForward": "ignore"
    },
    "3001": {
      "onAutoForward": "ignore"
    }
  }
}
