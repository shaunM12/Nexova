{
  "name": "nexova",
  "version": "1.0.0",
  "private": true,
  "description": "Nexova — public site, backoffice Talent Pipeline Tracker, and candidate matching engine",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "bash scripts/dev.sh",
    "dev:backoffice": "bash scripts/dev.sh /backoffice",
    "dev:server": "next dev -p 3456 -H 127.0.0.1",
    "build": "next build",
    "start": "next start -p 3456 -H 127.0.0.1",
    "lint": "next lint",
    "open": "bash scripts/open-firefox.sh",
    "ports": "bash scripts/ports.sh",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:pipeline": "vitest run --project pipeline",
    "fundamentals": "vitest run --project engine"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "next": "^15.5.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-hook-form": "^7.89.0",
    "sonner": "^2.0.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^22.18.1",
    "@types/react": "^19.1.12",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.35.0",
    "eslint-config-next": "^15.5.3",
    "jsdom": "^30.1.1",
    "msw": "^2.15.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.9.2",
    "vite": "^7.3.6",
    "vitest": "^3.2.4"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
